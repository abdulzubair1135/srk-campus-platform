# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000,http://localhost:8080

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/campus_coordination_db
MONGODB_TEST_URI=mongodb://localhost:27017/campus_coordination_test_db

# JWT & Authentication Secrets
JWT_SECRET=super_secret_access_jwt_key_campus_presence_2026_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_campus_presence_2026_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cryptographic QR HMAC Secret
QR_HMAC_SECRET=super_secret_qr_hmac_signing_key_2026_change_in_prod
QR_NONCE_TTL_SECONDS=30

# Firebase Cloud Messaging
FCM_PROJECT_ID=campus-presence-system
FCM_CLIENT_EMAIL=firebase-adminsdk@campus-presence-system.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SYNC_RATE_LIMIT_MAX_REQUESTS=300
